// Esquema de la base (Neon, proyecto cli-vx3). Convenciones en tecnica_doc/tecnica.md §5:
// tablas y columnas en inglés, snake_case y en plural; IDs uuid v7 generados en la app
// (src/db/ids.ts); fechas en timestamptz; montos en centavos (bigint).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Auth (Better Auth, tecnica_doc/tecnica.md §6) --------------------------------
// Los nombres de los campos son los que espera Better Auth; las columnas, nuestras.

/// Persona que usa la app. Sin registro público: la crea un admin (o el script
/// auth:create-admin) con una contraseña temporal.
model User {
  id                 String    @id @db.Uuid
  name               String
  email              String    @unique
  emailVerified      Boolean   @default(false) @map("email_verified")
  image              String?
  /// Para entrar con usuario en vez de email (plugin username), en minúsculas.
  username           String?   @unique
  displayUsername    String?   @map("display_username")
  /// Uno de los roles de src/modules/platform/permissions.ts.
  role               String?
  /// Desactivado por un admin: no puede entrar y pierde sus sesiones.
  banned             Boolean?  @default(false)
  banReason          String?   @map("ban_reason")
  banExpires         DateTime? @map("ban_expires") @db.Timestamptz(6)
  /// Entró con una contraseña temporal: la tiene que cambiar antes de seguir.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// Puesto o tarea, para que el equipo sepa quién es quién.
  jobTitle           String?   @map("job_title")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions           Session[]
  accounts           Account[]

  @@map("users")
}

/// Sesión abierta. La cookie lleva el token firmado con AUTH_SECRET.
model Session {
  id             String   @id @db.Uuid
  token          String   @unique
  userId         String   @map("user_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Credenciales del usuario: el hash de la contraseña (providerId "credential").
model Account {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// Tokens de un solo uso de Better Auth (hoy no se usan: queda para el recupero por mail).
model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// Intentos fallidos de login por usuario y por IP (src/modules/platform/auth/throttle.ts).
model LoginThrottle {
  /// "user:<email o usuario>" o "ip:<dirección>".
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(6)
  /// Cuántas veces se bloqueó seguidas: la espera se duplica con cada una.
  lockouts        Int       @default(0)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("login_throttles")
}

/// Credencial de una cuenta del cliente (token de DUX…), cifrada con AES-256-GCM (RF-M0-06).
/// La clave maestra vive fuera de la base (CREDENTIALS_KEY): acá queda lo cifrado y la máscara.
model IntegrationCredential {
  id            String   @id @db.Uuid
  integration   String   @unique
  encrypted     String
  mask          String
  loadedById    String   @map("loaded_by_id") @db.Uuid
  loadedByLabel String   @map("loaded_by_label")
  loadedAt      DateTime @map("loaded_at") @db.Timestamptz(6)

  @@map("integration_credentials")
}

/// Próximo turno libre para llamar a un proveedor, compartido entre instancias (src/lib/rate-limit.ts).
model RateLimit {
  key        String   @id
  nextSlotAt DateTime @map("next_slot_at") @db.Timestamptz(6)

  @@map("rate_limits")
}

// ---- Espejo de DUX (RF-M2-01, solucion_doc/06 §6) ----------------------------------
// DUX manda: acá se guarda lo que dice, sin corregirlo. Nunca se edita a mano.
// De los comprobantes no se guardan el nombre, el CUIT ni el documento de la clienta:
// se llega a ella por su ID, y lo personal queda en una sola tabla (dux_customers).

/// Cómo se lee un código (src/modules/catalog/codigos.ts).
enum DuxItemKind {
  prenda
  pack
  pack_viejo
  combo
  no_producto

  @@map("dux_item_kind")
}

/// Un item de /v2/items: prenda, pack o combo, con su stock y sus precios.
model DuxItem {
  id             String      @id @db.Uuid
  /// cod_item tal como viene de DUX ("LN 25"): sirve para volver a pedírselo.
  code           String      @unique
  /// El mismo código escrito igual en todas las fuentes ("LN25").
  normalizedCode String      @map("normalized_code")
  kind           DuxItemKind
  /// La identidad del producto ("MSU2-1"): une la prenda con sus packs.
  baseCode       String      @map("base_code")
  packQuantity   Int?        @map("pack_quantity")
  /// El -3 fuera de medias: la regla no lo prevé (solucion_doc/10 §8).
  outOfRule      Boolean     @default(false) @map("out_of_rule")
  name           String
  category       String?
  subcategory    String?
  brand          String?
  supplierId     Int?        @map("supplier_id")
  supplier       String?
  costCents      BigInt      @map("cost_cents")
  /// Las 5 listas: [{ listId, list, cents }].
  prices         Json
  /// Sumados entre depósitos y variantes. Hasta 8 decimales, como DUX: un pack se calcula desde la prenda.
  stockReal      Decimal     @map("stock_real") @db.Decimal(18, 8)
  stockReserved  Decimal     @map("stock_reserved") @db.Decimal(18, 8)
  stockAvailable Decimal     @map("stock_available") @db.Decimal(18, 8)
  enabled        Boolean
  externalCode   String?     @map("external_code")
  imageUrl       String?     @map("image_url")
  /// fecha_creacion en DUX.
  createdOn      DateTime    @map("created_on") @db.Date
  /// Huella de lo leído: si no cambió, no se reescribe la fila.
  contentHash    String      @map("content_hash")
  /// false: dejó de aparecer en /v2/items. No se borra: las ventas se leen contra esos códigos.
  present        Boolean     @default(true)
  firstSeenAt    DateTime    @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime    @map("last_seen_at") @db.Timestamptz(6)
  changedAt      DateTime    @map("changed_at") @db.Timestamptz(6)

  @@index([baseCode])
  @@index([normalizedCode])
  @@map("dux_items")
}

/// Un comprobante de la v1 de /facturas. Incluye anulados y notas de crédito, marcados:
/// no se suman a la venta, pero tienen que verse si cambian.
model DuxInvoice {
  id            String           @id @db.Uuid
  duxId         Int              @unique @map("dux_id")
  branchId      Int              @map("branch_id")
  /// tipo_comp: COMPROBANTE_VENTA, NOTA_CREDITO…
  type          String
  letter        String
  pointOfSale   String           @map("point_of_sale")
  /// DUX tiene facturas sin número: son ventas válidas, y no se le inventa uno.
  number        Int?
  issuedOn      DateTime         @map("issued_on") @db.Date
  /// id_cliente en DUX. Sin clave foránea: el comprobante puede llegar antes que la clienta.
  customerDuxId Int?             @map("customer_dux_id")
  /// nro_pedido. Nunca se cruza por número (RN-91).
  orderNumber   String?          @map("order_number")
  /// Las notas de crédito vienen con total positivo: se filtran por tipo, no por signo.
  totalCents    BigInt           @map("total_cents")
  cancelled     Boolean
  contentHash   String           @map("content_hash")
  firstSeenAt   DateTime         @map("first_seen_at") @db.Timestamptz(6)
  changedAt     DateTime         @map("changed_at") @db.Timestamptz(6)
  items         DuxInvoiceItem[]

  @@index([issuedOn])
  @@index([customerDuxId])
  @@map("dux_invoices")
}

/// Una línea de un comprobante. DUX no le da ID (tmp_det_facturacion_id viene en null): la
/// identifica su posición. El costo es el congelado al vender, no el vigente (RN-109).
model DuxInvoiceItem {
  id             String      @id @db.Uuid
  invoiceId      String      @map("invoice_id") @db.Uuid
  invoice        DuxInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  line           Int
  code           String
  kind           DuxItemKind
  baseCode       String      @map("base_code")
  /// Unidades por presentación: del código o, en las ventas de antes del 10/10, del nombre (RN-120).
  packQuantity   Int?        @map("pack_quantity")
  name           String
  quantity       Decimal     @db.Decimal(18, 8)
  unitPriceCents BigInt      @map("unit_price_cents")
  discountPct    Decimal     @map("discount_pct") @db.Decimal(7, 4)
  vatPct         Decimal     @map("vat_pct") @db.Decimal(7, 4)
  costCents      BigInt      @map("cost_cents")

  @@unique([invoiceId, line])
  @@index([baseCode])
  @@map("dux_invoice_items")
}

/// Una clienta de DUX: la única tabla del espejo con datos personales. Fuera de producción
/// se anonimizan al entrar (tecnica_doc/fases/fase-1.4.md, decisión 2). Del domicilio y el
/// documento no se guarda nada: nada los usa todavía.
model DuxCustomer {
  id              String    @id @db.Uuid
  duxId           Int       @unique @map("dux_id")
  name            String
  /// El nombre de pila, cuando DUX lo tiene aparte: para saludar sin arriesgar con un apellido.
  firstName       String?   @map("first_name")
  phone           String?
  /// Los últimos 10 dígitos: la identidad de la clienta (RN-90).
  normalizedPhone String?   @map("normalized_phone")
  email           String?
  province        String?
  city            String?
  enabled         Boolean
  createdOn       DateTime? @map("created_on") @db.Date
  contentHash     String    @map("content_hash")
  firstSeenAt     DateTime  @map("first_seen_at") @db.Timestamptz(6)
  changedAt       DateTime  @map("changed_at") @db.Timestamptz(6)

  @@index([normalizedPhone])
  @@map("dux_customers")
}

enum SyncRunStatus {
  en_curso
  ok
  con_errores
  error

  @@map("sync_run_status")
}

/// Una corrida de sincronización: lo que muestra el panel de integraciones (RF-M0-04).
/// Nunca dos sincronizaciones a la vez de una integración. Vence solo: si un Workflow
/// muere sin soltarlo, no traba para siempre.
/// Una clienta: una fila por teléfono (RN-90), armada desde dux_customers y recalculada
/// en cada sincronización. Una ficha de DUX sin teléfono no llega acá.
enum CustomerSegment {
  nueva
  activa
  top
  en_riesgo
  dormida

  @@map("customer_segment")
}

model Customer {
  id                 String           @id @db.Uuid
  normalizedPhone    String           @unique @map("normalized_phone")
  name               String
  firstName          String?          @map("first_name")
  phone              String
  email              String?
  province           String?
  city               String?
  /// Cuántas fichas de DUX son esta clienta.
  duxRecords         Int              @map("dux_records")
  /// Días con compras válidas: los comprobantes del mismo día son una compra.
  purchases          Int              @default(0)
  totalCents         BigInt           @default(0) @map("total_cents")
  marginCents        BigInt           @default(0) @map("margin_cents")
  /// El de los últimos 12 meses: define quién es Top y el orden de la lista del día.
  margin12mCents     BigInt           @default(0) @map("margin_12m_cents")
  firstPurchaseOn    DateTime?        @map("first_purchase_on") @db.Date
  lastPurchaseOn     DateTime?        @map("last_purchase_on") @db.Date
  /// Mediana de los días entre compras; null con menos de dos.
  cycleDays          Float?           @map("cycle_days")
  /// Sin anuncios todavía, es lo único que se sabe de cómo llegó (1.6).
  firstPurchaseLocal Boolean          @default(false) @map("first_purchase_local")
  /// Nombre, localidad y provincia, sin tildes ni mayúsculas: para buscar en la base.
  searchText         String           @default("") @map("search_text")
  /// null: no tiene compras en lo que está leído.
  segment            CustomerSegment?
  contentHash        String           @map("content_hash")
  firstSeenAt        DateTime         @map("first_seen_at") @db.Timestamptz(6)
  changedAt          DateTime         @map("changed_at") @db.Timestamptz(6)

  reactivationContacts ReactivationContact[]

  @@index([segment])
  @@map("customers")
}

enum CatalogLifecycle {
  activo
  agotado
  historico

  @@map("catalog_lifecycle")
}

enum CatalogPriority {
  A
  B
  C

  @@map("catalog_priority")
}

/// Copia cruda del Sheet: se reemplaza entera en cada lectura (`solucion_doc/06` §6.2).
model CatalogSheetRow {
  id        String   @id @db.Uuid
  rowNumber Int      @unique @map("row_number")
  /// Lo que ve el equipo, por encabezado.
  shown     Json
  /// El valor crudo, por encabezado: un "1,5" escrito como texto se nota acá.
  raw       Json
  readAt    DateTime @map("read_at") @db.Timestamptz(6)

  @@map("catalog_sheet_rows")
}

/// Copia cruda de Drive: los datos de cada archivo, no las fotos.
model CatalogDriveFile {
  id         String    @id @db.Uuid
  driveId    String    @unique @map("drive_id")
  name       String
  mimeType   String    @map("mime_type")
  bytes      BigInt?
  md5        String?
  width      Int?
  height     Int?
  /// "Repositorio Fotos/Mallas": la carpeta donde está.
  folder     String
  modifiedAt DateTime? @map("modified_at") @db.Timestamptz(6)
  readAt     DateTime  @map("read_at") @db.Timestamptz(6)

  @@map("catalog_drive_files")
}

/// El producto, armado desde el Sheet, Drive y DUX. Hasta el pase es descartable: se puede
/// borrar y reimportar. Lo que no se puede perder está en CatalogDecision.
model CatalogProduct {
  id            String                @id @db.Uuid
  /// La llave natural: "MSU2-1". Se cruza siempre por SKU, nunca por nombre (RN-127).
  baseCode      String                @unique @map("base_code")
  name          String
  isCombo       Boolean               @map("is_combo")
  category      String?
  subcategory   String?
  brand         String?
  /// El último: un producto puede venir de varios (RN-128).
  lastSupplier  String?               @map("last_supplier")
  fabric        String?
  colors        String?
  sizes         String?
  /// Copa, encaje, push up, aro, elástico, bretel, gancho y otros detalles.
  attributes    Json
  lengthCm      Decimal?              @map("length_cm") @db.Decimal(8, 2)
  widthCm       Decimal?              @map("width_cm") @db.Decimal(8, 2)
  heightCm      Decimal?              @map("height_cm") @db.Decimal(8, 2)
  weightKg      Decimal?              @map("weight_kg") @db.Decimal(8, 3)
  lifecycle     CatalogLifecycle
  /// Invierno, pijama y mallas: sin ventas ahora no quiere decir que ya no se vendan.
  seasonal      Boolean
  priority      CatalogPriority
  salesRank     Int?                  @map("sales_rank")
  sales90dCents BigInt                @map("sales_90d_cents")
  lastSaleOn    DateTime?             @map("last_sale_on") @db.Date
  /// Lo que le falta (RN-124): [{ dato, situacion }], con "falta" o "no_hay_dato".
  missing       Json
  readyToSell   Boolean               @map("ready_to_sell")
  inSheet       Boolean               @map("in_sheet")
  inDux         Boolean               @map("in_dux")
  sheetRow      Int?                  @map("sheet_row")
  /// false: dejó de aparecer en las fuentes. No se borra: las ventas se leen contra ese código.
  present       Boolean               @default(true)
  /// Sin tildes ni mayúsculas: para buscar en la base.
  searchText    String                @map("search_text")
  contentHash   String                @map("content_hash")
  firstSeenAt   DateTime              @map("first_seen_at") @db.Timestamptz(6)
  changedAt     DateTime              @map("changed_at") @db.Timestamptz(6)
  presentations CatalogPresentation[]
  photos        CatalogPhoto[]

  @@index([category])
  @@index([lifecycle])
  @@index([priority])
  @@map("catalog_products")
}

/// Cada forma de venderlo: la prenda, sus packs o el combo. Precio y stock se leen del espejo de DUX por el código.
model CatalogPresentation {
  id        String         @id @db.Uuid
  productId String         @map("product_id") @db.Uuid
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String         @unique
  kind      DuxItemKind
  /// Unidades del pack; null en la prenda y en el combo.
  quantity  Int?
  inDux     Boolean        @map("in_dux")

  @@index([productId])
  @@map("catalog_presentations")
}

model CatalogPhoto {
  id        String         @id @db.Uuid
  productId String         @map("product_id") @db.Uuid
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  driveId   String         @unique @map("drive_id")
  name      String
  position  Int
  width     Int?
  height    Int?

  @@index([productId])
  @@map("catalog_photos")
}

/// Lo que una persona tiene que revisar. Se regenera en cada importación: lo corregido en la fuente desaparece solo.
model CatalogReviewCase {
  id          String           @id @db.Uuid
  block       String
  /// Lo que identifica al caso dentro del bloque: un código o un archivo.
  key         String
  baseCode    String?          @map("base_code")
  priority    CatalogPriority?
  salesRank   Int?             @map("sales_rank")
  description String
  /// "sheet", "dux", "drive" o "app".
  fixIn       String           @map("fix_in")
  sheetRow    Int?             @map("sheet_row")
  details     Json

  @@unique([block, key])
  @@index([block])
  @@map("catalog_review_cases")
}

/// Lo que el Sheet no puede guardar: a qué producto va una foto suelta, si se descarta, y los
/// históricos. Sobrevive a cualquier importación, y cada corrida la vuelve a aplicar.
model CatalogDecision {
  id             String   @id @db.Uuid
  type           String
  /// La llave natural: un código o un archivo de Drive.
  key            String
  value          Json
  decidedById    String?  @map("decided_by_id")
  decidedByLabel String   @map("decided_by_label")
  decidedAt      DateTime @map("decided_at") @db.Timestamptz(6)

  @@unique([type, key])
  @@map("catalog_decisions")
}

enum ReactivationStage {
  m1
  m2
  m3
  m4
  reactivacion
  alto_valor

  @@map("reactivation_stage")
}

enum ReactivationStatus {
  contactada
  respondio
  pospuesta

  @@map("reactivation_status")
}

/// Lo que se hizo con la lista del día. Lo escribe una persona: la app no manda nada.
model ReactivationContact {
  id          String             @id @db.Uuid
  customerId  String             @map("customer_id") @db.Uuid
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// El día del negocio del mensaje.
  contactedOn DateTime           @map("contacted_on") @db.Date
  stage       ReactivationStage
  /// Qué plantilla le tocó: no se repite la vez siguiente (RN-74).
  variant     String
  status      ReactivationStatus
  /// El texto que se mandó, con lo que la persona haya editado.
  message     String
  respondedOn DateTime?          @map("responded_on") @db.Date
  actorId     String?            @map("actor_id")
  createdAt   DateTime           @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @map("updated_at") @db.Timestamptz(6)

  @@unique([customerId, contactedOn])
  @@index([contactedOn])
  @@map("reactivation_contacts")
}

model SyncLock {
  integration String   @id
  holder      String
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("sync_locks")
}

model SyncRun {
  id          String        @id @db.Uuid
  integration String
  /// "items", "ventas", "clientas".
  operation   String
  status      SyncRunStatus
  /// "cron" o "manual".
  trigger     String
  /// Quién apretó el botón; null si la disparó el cron.
  triggeredBy String?       @map("triggered_by")
  startedAt   DateTime      @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?     @map("finished_at") @db.Timestamptz(6)
  calls       Int           @default(0)
  records     Int           @default(0)
  /// Qué pasó, para el panel. Sin datos personales.
  detail      String?

  @@index([integration, startedAt(sort: Desc)])
  @@map("sync_runs")
}

/// Registro de acciones sensibles: quién hizo qué, sobre qué y cuándo (RF-M0-03).
/// El actor puede ser una persona, el bot o un proceso, por eso no apunta a usuarios.
model AuditLog {
  id         String   @id @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId    String?  @map("actor_id") @db.Uuid
  actorLabel String   @map("actor_label")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  requestId  String?  @map("request_id")

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("audit_logs")
}
