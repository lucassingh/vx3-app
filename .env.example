# Copiá este archivo como .env.local y completá los valores.
#
# Las variables se validan en src/env.ts: si falta una obligatoria o tiene mal
# formato, la app no arranca y el error dice cuál y qué hacer.
#   Obligatorias en desarrollo:  DATABASE_URL, DATABASE_URL_UNPOOLED
#   Obligatorias en producción:  DATABASE_URL (usuario app) y AUTH_SECRET
# Los secretos van solo acá y en la bóveda de 1Password "Cliente · VX3"; nunca en el repo.

# --- API: simulada o real, dominio por dominio -------------------------------------
# Dominios que usan su implementación real, separados por coma (los nombres están en
# src/lib/api/domains.ts: dashboard, cobros, stock, catalogo…). Vacía = todo simulado.
API_REAL_DOMAINS=
# Latencia base de cada respuesta simulada, en ms (±30 %). 0 = instantánea.
MOCK_API_DELAY_MS=350
# Probabilidad de 0 a 1 de que una respuesta simulada falle con 503, para ver los
# estados de error. 0 = nunca falla.
MOCK_API_FAILURE_RATE=0

# --- Logs ---------------------------------------------------------------------------
# fatal, error, warn, info, debug, trace o silent. Vacía: debug en desarrollo, info en
# producción y silent en los tests.
LOG_LEVEL=

# --- Sesión -------------------------------------------------------------------------
# Firma de la cookie de sesión, de al menos 32 caracteres. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# En desarrollo puede quedar vacía; en producción es obligatoria.
AUTH_SECRET=
# URL pública de la app (Better Auth). Vacía en local = http://localhost:3000; en QA
# y en las previews, la del deploy de Vercel. En producción: https://cli-vx3.vercel.app
# (o el dominio, cuando haya).
BETTER_AUTH_URL=

# --- Base de datos (Neon, proyecto cli-vx3) --------------------------------------
# Neon → Connect → branch develop en local (main en producción).
# Con "Connection pooling" prendido (el host lleva -pooler). La usa la app. En Vercel va
# con el usuario app, que no puede tocar el esquema (npm run db:roles, src/db/roles.ts).
DATABASE_URL=
# La misma branch con "Connection pooling" apagado (conexión directa), con el dueño
# (neondb_owner). La usa Prisma para las migraciones; no va en Vercel.
DATABASE_URL_UNPOOLED=
# Neon → Settings del proyecto → API keys (key de proyecto). Para crear las branches
# efímeras de los tests de integración y de las previews.
NEON_API_KEY=
# Neon → Settings del proyecto → General → Project ID.
NEON_PROJECT_ID=

# --- DUX (ERP) ----------------------------------------------------------------------
# Solo del servidor: nunca con NEXT_PUBLIC_.
# Límite: un request cada 5,5 s POR CUENTA, compartido con los scripts de Elías y el
# Hub (usan el mismo token). Antes de probar contra la API real, acordar la ventana con Elías.
DUX_API_URL=https://erp.duxsoftware.com.ar/WSERP/rest/services
# El token de la cuenta de VX3: está en la bóveda "Cliente · VX3".
DUX_TOKEN=
# 9432. La documentación vieja dice 9954 y está mal: DUX responde 200 con
# "Empresa no encontrada.", así que el error no se ve en el código HTTP.
DUX_ID_EMPRESA=9432
# 1 = ecommerce (Elías) · 2 = local (Juan). En la práctica es un solo lugar físico.
DUX_ID_SUCURSAL_ECOMMERCE=1
DUX_ID_SUCURSAL_LOCAL=2
# Depósito para /v2/stock (pide id_deposito o cod_item). Hoy el único es "DEPOSITO TEMPERLEY".
DUX_ID_DEPOSITO=18516

# --- Sentry (errores) ---------------------------------------------------------------
# Sentry → proyecto cli-vx3 → Settings → Client Keys (DSN). No es secreto: va en las
# variables de Vercel de QA y producción. Vacía en local: Sentry queda apagado.
NEXT_PUBLIC_SENTRY_DSN=
# Para subir los source maps en el build. Solo en los secrets del repo (los deploys);
# en local no hacen falta.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=

# --- Solo para la CI ------------------------------------------------------------------
# SKIP_ENV_VALIDATION=1 deja compilar y correr el lint sin los secretos.
# SKIP_ENV_VALIDATION=
