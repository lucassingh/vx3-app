# Copiá este archivo como .env.local y completá lo que necesites.

# --- Mock de la API -------------------------------------------------------------
# Interruptor único (ver src/lib/api/config.ts).
#   true  = API simulada de src/mocks (default si queda vacía).
#   false = API real: hay que completar API_URL y NEXT_PUBLIC_API_URL.
# Next la fija al compilar: después de cambiarla, reiniciá npm run dev.
NEXT_PUBLIC_API_MOCK=true

# --- API real -----------------------------------------------------------------
# URL base que usa el servidor (Server Components, Route Handlers, Server Actions).
API_URL=
# URL base que usa el navegador (Client Components). Suele ser la misma.
NEXT_PUBLIC_API_URL=

# --- API simulada ---------------------------------------------------------------
# Latencia base de cada respuesta en ms (con ±30 % de variación). 0 = instantánea.
MOCK_API_DELAY_MS=350
# Probabilidad de 0 a 1 de que una respuesta falle con 503, para probar los
# estados de error. 0 = nunca falla.
MOCK_API_FAILURE_RATE=0

# --- Sesión ----------------------------------------------------------------------
# Firma de la cookie de sesión. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

DATABASE_URL=            # conexión con pooler de la branch dev
DATABASE_URL_UNPOOLED=   # conexión directa de la branch dev (para migraciones)
NEON_API_KEY=            # para crear las branches de tests y de cada PR
NEON_PROJECT_ID=         # id del proyecto neon

# --- DUX (ERP) -------------------------------------------------------------------
# Solo del servidor: nunca con NEXT_PUBLIC_. El token va acá y en 1Password, no en el repo.
# Límite: un request cada 5,5 s POR CUENTA, compartido con los scripts de Elías y el
# Hub (usan el mismo token). Antes de probar contra la API real, acordar la ventana con Elías.
DUX_API_URL=https://erp.duxsoftware.com.ar/WSERP/rest/services
DUX_TOKEN=
# 9432. La documentación vieja dice 9954 y está mal: DUX responde 200 con
# "Empresa no encontrada.", así que el error no se ve en el código HTTP.
DUX_ID_EMPRESA=9432
# 1 = ecommerce (Elías) · 2 = local (Juan). En la práctica es un solo lugar físico.
DUX_ID_SUCURSAL_ECOMMERCE=1
DUX_ID_SUCURSAL_LOCAL=2
# Depósito para /v2/stock (lo pide: id_deposito o cod_item). Hoy el único que aparece es "DEPOSITO TEMPERLEY".
DUX_ID_DEPOSITO=18516
